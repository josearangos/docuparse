    {
      "name": "RapidOCR (fast CPU engine, port 8001)",
      "description": "Start with: DOCUPARSE_ENGINE=rapidocr uv run --extra fast uvicorn docuparse.main:app --port 8001. Returns text lines only: no tables, formulas or charts.",
      "item": [
        {
          "name": "Health (RapidOCR)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrlFast}}/health",
              "host": [
                "{{baseUrlFast}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('healthy', () => pm.expect(pm.response.json().status).to.eql('healthy'));"
                ]
              }
            }
          ]
        },
        {
          "name": "OCR - factura.png",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "tests/samples/factura.png"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrlFast}}/ocr",
              "host": [
                "{{baseUrlFast}}"
              ],
              "path": [
                "ocr"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('has text elements', () => body.pages[0].elements.length > 0);",
                  "pm.test('no tables (text-only engine)', () => body.pages.every(p => p.tables.length === 0));"
                ]
              }
            }
          ]
        },
